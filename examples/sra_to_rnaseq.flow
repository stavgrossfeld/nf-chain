"""Public RNA-seq data, downloaded and quantified in one chain.

    nfchain explain examples/sra_to_rnaseq.flow
    nfchain build   examples/sra_to_rnaseq.flow
    nfchain run     examples/sra_to_rnaseq.flow --profile docker
"""

from nf-core import sratools
from nf-core import rnaseq

# `sratools` is an alias for nf-core/fetchngs, the pipeline that wraps sra-tools.
sra = sratools(ids=["SRR6357070", "SRR6357071"])

# `input` is wired to the samplesheet fetchngs publishes. Drop the argument
# entirely and nf-chain infers the same edge — this spells it out.
rna = rnaseq(
    input=sra.samplesheet,
    genome="GRCh38",
    rev="3.14.0",
)
